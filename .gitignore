**/data/processed/*
**/data/outputs/*
!**/data/raw_articles/.gitkeep
!**/data/processed/.gitkeep
!**/data/outputs/.gitkeep

# Editors
.vscode/
.idea/

# OS noise
desktop.ini
.DS_Store
Thumbs.db

