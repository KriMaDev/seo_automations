# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtual environments
.venv/
venv/
env/

# Environment variables / secrets
.env
*.env.local

# Logs (keep the folder, ignore generated log files)
**/logs/*.log

# Collected/generated data (keep the folder structure, ignore contents)
**/data/raw_articles/*
**/data/processed/*
**/data/outputs/*
!**/data/raw_articles/.gitkeep
!**/data/processed/.gitkeep
!**/data/outputs/.gitkeep

# Editors
.vscode/
.idea/

# Claude Code local settings
.claude/settings.local.json
